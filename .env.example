APP_NAME=HATTORI AI Assistant
APP_ENV=development
POSTGRES_PASSWORD=change_me
# For running the API outside Docker Compose, uncomment and use localhost:
# DATABASE_URL=postgresql+psycopg://hattori:change_me@localhost:5432/hattori

# Altegio placeholders. Confirm the API surface/version and paths before use.
ALTEGIO_BASE_URL=https://api.example.invalid
ALTEGIO_API_TOKEN=replace_with_partner_token
ALTEGIO_USER_TOKEN=replace_with_user_token_if_required
ALTEGIO_BRANCH_ID=replace_with_location_id
ALTEGIO_ACCEPT_HEADER=application/json
ALTEGIO_TIMEOUT_SECONDS=10
ALTEGIO_SERVICES_PATH=/replace_with_services_path
ALTEGIO_MASTERS_PATH=/replace_with_masters_path
ALTEGIO_AVAILABLE_SLOTS_PATH=/replace_with_available_slots_path
ALTEGIO_CREATE_BOOKING_PATH=/replace_with_create_booking_path
ALTEGIO_CANCEL_BOOKING_PATH=/replace_with_cancel_booking_path/{booking_id}
ALTEGIO_CANCEL_BOOKING_METHOD=replace_with_post_or_delete
